import { Theme } from "theme.slint";
import { Chip } from "widgets.slint";
import { DialogFrame, Note } from "dialog.slint";

/// Help > About (src/app/about.rs): the logo, version, author and the project's links.
export global AboutState {
    in-out property <bool> visible;
    in property <string> version;
    /// Opens a web address in the browser.
    callback open(string);
    /// A newer release found at launch (src/app/about.rs): its version and page. Empty: none.
    in-out property <string> update;
    in property <string> update-url;
    /// How the in-place update is going ("Downloading…", an error…); empty while there is nothing to report.
    in-out property <string> update-status;
    /// 0 to 1 while the archive downloads.
    in-out property <float> update-progress: 0;
    /// Downloads the release, verifies it and replaces the app, then restarts it (src/app/update.rs).
    callback install();
}

/// One "label   link" row; the link opens `url`.
component Link inherits HorizontalLayout {
    in property <string> label;
    in property <string> text;
    in property <string> url;
    spacing: Theme.space-lg;
    Text { text: root.label; width: 90px; color: Theme.text-dim; font-family: Theme.font; font-size: Theme.font-md; font-weight: Theme.weight-bold; }
    Text {
        text: root.text;
        color: ta.has-hover ? Theme.text-bright : Theme.accent-hi;
        font-family: Theme.font;
        font-size: Theme.font-md;
        overflow: elide;
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { AboutState.open(root.url); }
        }
    }
}

export component AboutOverlay inherits DialogFrame {
    visible: AboutState.visible;
    title: "ABOUT OPENFADER";
    card-width: 460px;
    closed => { AboutState.visible = false; }
    HorizontalLayout {
        alignment: center;
        Image { source: @image-url("../assets/icon.png"); width: 112px; height: 112px; }
    }
    VerticalLayout {
        spacing: Theme.space-xs;
        Text { text: "MyOpenFadeR"; horizontal-alignment: center; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.font-md * 1.6; font-weight: Theme.weight-bold; }
        Text { text: "Version " + AboutState.version; horizontal-alignment: center; color: Theme.text-dim; font-family: Theme.font; font-size: Theme.font-md; }
        Text { text: "Open-source DJ software for two or four decks"; horizontal-alignment: center; color: Theme.text; font-family: Theme.font; font-size: Theme.font-md; }
    }
    Rectangle { height: 1px; background: Theme.line; }
    VerticalLayout {
        spacing: Theme.space-sm;
        Link { label: "AUTHOR"; text: "OpenRsG (original OpenFadeR)"; url: "https://github.com/OpenRsG"; }
        Link { label: "SOURCE"; text: "github.com/ronellcl/MyOpenFadeR"; url: "https://github.com/ronellcl/MyOpenFadeR"; }
        Link { label: "PLUGINS"; text: "github.com/ronellcl/MyOpenFadeR-Plugins"; url: "https://github.com/ronellcl/MyOpenFadeR-Plugins"; }
        Link { label: "THEMES"; text: "github.com/ronellcl/MyOpenFadeR-Themes"; url: "https://github.com/ronellcl/MyOpenFadeR-Themes"; }
        Link { label: "MAPPINGS"; text: "github.com/ronellcl/MyOpenFadeR-Map"; url: "https://github.com/ronellcl/MyOpenFadeR-Map"; }
        Link { label: "ISSUES"; text: "Report a bug or ask for a feature"; url: "https://github.com/ronellcl/MyOpenFadeR/issues"; }
        Link { label: "LICENSE"; text: "GNU AGPL v3"; url: "https://github.com/ronellcl/MyOpenFadeR/blob/main/LICENSE"; }
    }
    Note { text: "Free software: you may use, share and change it under the AGPL. MyOpenFadeR is a fork of OpenFadeR by OpenRsG, built with Rust and Slint."; wrap: word-wrap; horizontal-alignment: center; }
}

/// Shown at launch when GitHub has a newer release: UPDATE installs it in place and restarts, LATER closes until the next
/// launch. The version line opens the release page.
export component UpdateOverlay inherits DialogFrame {
    visible: AboutState.update != "";
    title: "Update available";
    card-width: 440px;
    closed => { AboutState.update = ""; }
    HorizontalLayout {
        alignment: center;
        Image { source: @image-url("../assets/icon.png"); width: 72px; height: 72px; }
    }
    VerticalLayout {
        spacing: Theme.space-xs;
        Text { text: "MyOpenFadeR " + AboutState.update + " is out"; horizontal-alignment: center; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.font-xl; font-weight: Theme.weight-bold; }
        Text {
            text: "You have version " + AboutState.version + ". Click here for the release page.";
            horizontal-alignment: center;
            color: ta.has-hover ? Theme.text-bright : Theme.text-dim;
            font-family: Theme.font;
            font-size: Theme.font-md;
            wrap: word-wrap;
            ta := TouchArea { mouse-cursor: pointer; clicked => { AboutState.open(AboutState.update-url); } }
        }
        if AboutState.update-status != "": VerticalLayout {
            spacing: Theme.space-xs;
            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Theme.panel-raised;
                Rectangle { width: parent.width * AboutState.update-progress; height: parent.height; border-radius: 2px; background: Theme.accent; }
            }
            Text { text: AboutState.update-status; horizontal-alignment: center; color: Theme.text; font-family: Theme.font; font-size: Theme.font-sm; wrap: word-wrap; }
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.space-sm;
        Chip { text: "LATER"; width: 80px; horizontal-stretch: 0; enabled: AboutState.update-status == ""; clicked => { AboutState.update = ""; } }
        Chip { text: "UPDATE"; width: 110px; horizontal-stretch: 0; active: true; enabled: AboutState.update-status == ""; clicked => { AboutState.install(); } }
    }
}
